# Copy to .env, then configure the backend reachable from your device.
# The app loads .env automatically at startup; no CLI flag is required.
# Desktop/web: http://localhost:8080
# Android emulator: http://10.0.2.2:8080
# Physical device: use the backend LAN IP or domain.
# Client configuration is embedded in the build; keep server secrets on backend.
API_BASE_URL=http://localhost:8080
CASHIER_WEB_URL=

# Initial device preference only; a saved in-app choice takes priority.
REALTIME_ENABLED=false
REALTIME_TRANSPORT=websocket

# Leave empty to derive /ws from API_BASE_URL.
# HTTPS deployments use WSS, for example wss://pos.example.com/ws.
REALTIME_URL=
