# Copy to .env, then configure the backend reachable from your device.
# The app loads .env automatically at startup; no CLI flag is required.
# Desktop/web: http://localhost:8080
# Android emulator: http://10.0.2.2:8080
# Physical device: use the backend LAN IP or domain.
# Client configuration is embedded in the build; keep server secrets on backend.
API_BASE_URL=http://localhost:8080
CASHIER_WEB_URL=

# Initial device preference only; a saved in-app choice takes priority.
REALTIME_ENABLED=false
REALTIME_TRANSPORT=websocket

# Leave empty to derive /ws from API_BASE_URL.
# HTTPS deployments use WSS, for example wss://pos.example.com/ws.
REALTIME_URL=

# Public pages linked from Cài đặt (required by App Store / Google Play).
# Leave empty to hide the link.
PRIVACY_POLICY_URL=
TERMS_URL=

# Contact shown on the login screen. SUPPORT_WEB_URL opens in the browser
# (leave empty to hide it); SUPPORT_PHONE opens the dialler (default 1900 6522).
SUPPORT_WEB_URL=
SUPPORT_PHONE=

# Web page for signing up a new restaurant, opened from "Đăng ký" on the login
# screen. Empty uses https://xaypos.hiducourse.click/register.
REGISTER_URL=

# Web page where an owner buys or renews a package, opened from the "no active
# package" screen (not offered on iOS). Empty uses
# https://xaypos.hiducourse.click/onboarding.
SUBSCRIBE_URL=
